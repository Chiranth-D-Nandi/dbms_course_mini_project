# Owner: Person A
# ==============================================================================
# Environment Configuration Template - Tatkal Booking System
# Copy this file to .env and customize values for local development.
# ==============================================================================

# --- MySQL Database Configuration ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=tatkal_db

# Application User Credentials (used by Django Backend)
DB_APP_RW_USER=app_rw
DB_APP_RW_PASSWORD=TatkalRw_SecurePass#2026
DB_APP_RO_USER=app_ro
DB_APP_RO_PASSWORD=TatkalRo_SecurePass#2026

# --- Django Backend Configuration ---
DJANGO_SECRET_KEY=django-insecure-tatkal-production-grade-secret-key-salt-981273912
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simple JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-this-tatkal-2026-auth-token
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- ChromaDB & Sentence Transformer Vector Search ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
SENTENCE_TRANSFORMER_MODEL_PATH=./models/all-MiniLM-L6-v2

# --- Tatkal Window Demo Flag ---
# When True, sp_book_tickets allows booking outside the official 10:00/11:00 AM window
DEMO_BYPASS_TATKAL_WINDOW=False

# --- Frontend Next.js API Base URL ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
